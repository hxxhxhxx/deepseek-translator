<Window x:Class="DeepSeekTranslator.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 划词翻译 · 软件更新"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">
    <Border Style="{StaticResource CardBorder}" Margin="18" Padding="22,20">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="发现新版本"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" />

            <TextBlock x:Name="SubtitleText"
                       Margin="0,6,0,0"
                       FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" />

            <Border x:Name="NotesBorder"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="#F8FAFC"
                    BorderBrush="#EEF2F7"
                    BorderThickness="1"
                    CornerRadius="9">
                <TextBox x:Name="NotesText"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="11.5"
                         Foreground="#475569"
                         TextWrapping="Wrap"
                         MaxHeight="150"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Border>

            <TextBlock x:Name="MandatoryText"
                       Margin="0,10,0,0"
                       FontSize="11"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="此版本为强制更新，请尽快升级。" />

            <Grid Margin="0,16,0,0">
                <ProgressBar x:Name="ProgressBar"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="#DBEAFE"
                             BorderThickness="0"
                             Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SkipButton"
                        MinWidth="88"
                        Style="{StaticResource SecondaryButton}"
                        Content="稍后"
                        Margin="0,0,8,0"
                        Click="SkipButton_Click" />
                <Button x:Name="UpdateButton"
                        MinWidth="104"
                        Style="{StaticResource PrimaryButton}"
                        Content="立即更新"
                        Click="UpdateButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
