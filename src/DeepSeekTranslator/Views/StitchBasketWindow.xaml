<Window x:Class="DeepSeekTranslator.Views.StitchBasketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拼接翻译"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="12"
            Background="#FFFFFF"
            BorderBrush="#1F0F172A"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Opacity="0.22"
                              Color="#0F172A" />
        </Border.Effect>

        <StackPanel Margin="13,11,13,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="拼接翻译"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconButton}"
                        Content="×"
                        Width="24"
                        Height="24"
                        ToolTip="清空并关闭拼接篮"
                        Click="CloseButton_Click" />
                <TextBlock x:Name="CountText"
                           DockPanel.Dock="Right"
                           Margin="0,0,8,0"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="PreviewText"
                       Margin="0,7,0,0"
                       MaxHeight="46"
                       FontSize="11"
                       Foreground="#475569"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="17" />

            <TextBlock x:Name="StatusText"
                       Margin="0,5,0,0"
                       FontSize="10.5"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Grid Margin="0,9,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton"
                            Content="撤销最后一段"
                            Style="{StaticResource LinkButton}"
                            FontSize="10.5"
                            Click="UndoButton_Click" />
                    <Button x:Name="ClearButton"
                            Content="清空"
                            Style="{StaticResource LinkButton}"
                            FontSize="10.5"
                            Margin="12,0,0,0"
                            Click="ClearButton_Click" />
                </StackPanel>
                <Button x:Name="TranslateButton"
                        Content="翻译拼接"
                        HorizontalAlignment="Right"
                        Height="28"
                        Padding="12,0"
                        FontSize="10.5"
                        Style="{StaticResource PrimaryButton}"
                        Click="TranslateButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
