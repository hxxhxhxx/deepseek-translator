<Window x:Class="DeepSeekTranslator.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="诊断"
        Width="660"
        Height="680"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="环境与状态"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#0F172A" />
            <TextBlock Text="排查“按了没反应 / 取不到词 / 更新失败”时，把这份报告发给开发者即可。"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="#64748B"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="ReportBox"
                 Grid.Row="1"
                 Margin="0,10,0,12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="11.5"
                 Background="White"
                 BorderBrush="#E2E8F0"
                 BorderThickness="1"
                 Padding="10"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton"
                        Content="刷新"
                        Height="28"
                        Padding="14,0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click" />
                <Button x:Name="CopyButton"
                        Content="复制报告"
                        Height="28"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButton}"
                        Click="CopyButton_Click" />
                <Button x:Name="TestCaptureButton"
                        Content="测试当前选区"
                        Height="28"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButton}"
                        Click="TestCaptureButton_Click" />
                <Button x:Name="OpenLogsButton"
                        Content="打开日志目录"
                        Height="28"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenLogsButton_Click" />
                <Button x:Name="ClearCacheButton"
                        Content="清空缓存"
                        Height="28"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Style="{StaticResource SecondaryButton}"
                        Click="ClearCacheButton_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       FontSize="11"
                       Foreground="#475569"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
