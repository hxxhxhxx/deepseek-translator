<Window x:Class="DeepSeekTranslator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeepSeekTranslator.Controls"
        Title="DeepSeek 划词翻译 · 设置"
        Width="760"
        Height="780"
        MinWidth="620"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 品牌头部 -->
        <Grid Grid.Row="0" Margin="2,0,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                <TextBlock Text="D"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DeepSeek 划词翻译"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="全局取词 · Windows 桌面版"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Border x:Name="HeaderStatusPill"
                    Grid.Column="2"
                    Padding="11,6"
                    CornerRadius="999"
                    Background="#ECFDF5"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HeaderStatusDot"
                             Width="7"
                             Height="7"
                             Fill="#16A34A"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStatusText"
                               Text="本机运行"
                               Margin="6,0,0,0"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#166534" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="24,22,24,20">
                    <StackPanel>
                        <TextBlock Text="连接 DeepSeek"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="API Key 只会保存在本机 Windows 凭据保护下，不会写入网页或前端存储。"
                                   Margin="0,6,0,20"
                                   FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource LinkButton}"
                                    Content="获取 API Key ↗"
                                    Margin="10,0,0,0"
                                    Click="GetKeyButton_Click" />
                        </Grid>

                        <PasswordBox x:Name="ApiKeyBox"
                                     Style="{StaticResource InputPasswordBox}"
                                     PasswordChar="●" />

                        <TextBlock x:Name="KeyStatusText"
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="#7B8CA3"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource HintText}"
                                   Text="已保存的 Key 不会回显。留空保存表示不修改；更换时直接输入新的 Key。" />

                        <Grid Margin="0,19,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="翻译模型" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ModelComboBox"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectionChanged="ModelComboBox_SelectionChanged" />
                                <TextBlock x:Name="ModelDescriptionText"
                                           Style="{StaticResource HintText}"
                                           Margin="0,7,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OCR 语言" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OcrLanguageComboBox">
                                    <ComboBoxItem Tag="" Content="自动（系统语言）" />
                                    <ComboBoxItem Tag="zh-Hans" Content="中文（简体）" />
                                    <ComboBoxItem Tag="en-US" Content="English" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource HintText}"
                                           Margin="0,7,0,0"
                                           Text="用于截图 OCR，只影响文字识别，不影响 DeepSeek 翻译。" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AutoStartCheckBox"
                                  Margin="0,18,0,0"
                                  Content="开机自动启动（推荐，托盘常驻）" />

                        <CheckBox x:Name="SelectionIconCheckBox"
                                  Margin="0,10,0,0"
                                  Content="选中文字后，在鼠标旁显示翻译小图标（Word / 网页等）" />

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,6,0,0"
                                   Text="支持 Word、Edge/Chrome 网页（UIA），以及 PowerPoint、微信、Zotero、PDF（走剪贴板）。拖选文字或双击选词后出现；点一下即可翻译。" />

                        <Grid Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="保存设置"
                                        IsDefault="True"
                                        Click="SaveButton_Click" />
                                <Button x:Name="TestButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="测试连接"
                                        Margin="8,0,0,0"
                                        Click="TestButton_Click" />
                            </StackPanel>
                            <Button x:Name="ClearKeyButton"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource DangerButton}"
                                    Content="清除密钥"
                                    Click="ClearKeyButton_Click" />
                        </Grid>

                        <Border x:Name="StatusBox"
                                Margin="0,16,0,0"
                                Padding="10,9"
                                CornerRadius="8"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusText"
                                       FontSize="11.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="HotkeyCard"
                            Grid.Column="0"
                            Style="{StaticResource CardBorder}"
                            Padding="18,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="全局快捷键"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InkBrush}" />
                                <Button x:Name="ResetHotkeysButton"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource LinkButton}"
                                        Content="恢复默认"
                                        Click="ResetHotkeysButton_Click" />
                            </Grid>

                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="134" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="翻译当前选区" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                <controls:HotkeyTextBox x:Name="TranslateSelectionHotkeyBox"
                                                        Grid.Column="1"
                                                        Height="27"
                                                        Style="{StaticResource InputTextBox}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="134" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="翻译剪贴板" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                <controls:HotkeyTextBox x:Name="TranslateClipboardHotkeyBox"
                                                        Grid.Column="1"
                                                        Height="27"
                                                        Style="{StaticResource InputTextBox}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="134" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="截图 OCR 翻译" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                <controls:HotkeyTextBox x:Name="OcrHotkeyBox"
                                                        Grid.Column="1"
                                                        Height="27"
                                                        Style="{StaticResource InputTextBox}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="134" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="复制最近译文" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                <controls:HotkeyTextBox x:Name="CopyLastHotkeyBox"
                                                        Grid.Column="1"
                                                        Height="27"
                                                        Style="{StaticResource InputTextBox}" />
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}"
                                       Margin="0,12,0,0"
                                       Text="点击右侧输入框后直接按组合键；至少包含 Ctrl/Alt/Shift/Win。同一个键在 600ms 内按两次可录成双击式快捷键，例如 Ctrl+C+C（不会占用 Ctrl+C）。点击“保存设置”后立即生效。" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="工作方式"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="UsageHintText"
                                       Margin="0,10,0,0"
                                       FontSize="11.5"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       Text="Word 优先使用 UI Automation 读取选区；浏览器、PowerPoint、微信、Zotero、PDF 走剪贴板（自动 Ctrl+C）。管理员窗口请手动 Ctrl+C 后按快捷键翻译剪贴板。" />
                            <Button x:Name="OpenLogsButton"
                                    Style="{StaticResource LinkButton}"
                                    Content="打开日志目录"
                                    Margin="0,12,0,0"
                                    Click="OpenLogsButton_Click" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Padding="18,15" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="安全说明"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#334155" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource HintText}"
                                   Text="Key 使用 Windows DPAPI（CurrentUser）加密，仅当前 Windows 用户可解密，不写入 settings.json、日志或任何网页。内部分发时不要把 secret.dat 一起复制到其他电脑。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="3,14,3,0">
            <TextBlock x:Name="FooterText"
                       Text="DeepSeek 划词翻译 · 内部使用"
                       FontSize="10"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="EngineStatusText"
                       HorizontalAlignment="Right"
                       Text="UIA + Clipboard + OCR"
                       FontSize="10"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
