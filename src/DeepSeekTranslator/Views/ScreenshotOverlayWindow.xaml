<Window x:Class="DeepSeekTranslator.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图 OCR"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Image x:Name="ScreenshotImage" Stretch="Fill" SnapsToDevicePixels="True" />
        <Canvas x:Name="SelectionCanvas"
                Background="#66000000"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
            <Border x:Name="SelectionBorder"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    Background="#1AFFFFFF"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,26,0,0"
                Padding="16,9"
                CornerRadius="9"
                Background="#E60F172A"
                IsHitTestVisible="False">
            <TextBlock Text="拖动选择要 OCR 的区域  ·  Esc 取消"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
