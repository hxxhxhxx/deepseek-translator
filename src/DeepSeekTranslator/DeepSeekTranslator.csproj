<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DeepSeekTranslator</AssemblyName>
    <RootNamespace>DeepSeekTranslator</RootNamespace>
    <Version>1.3.7</Version>
    <FileVersion>1.3.7.0</FileVersion>
    <AssemblyVersion>1.3.7.0</AssemblyVersion>
    <Authors>Internal</Authors>
    <Description>Windows desktop selection translator powered by DeepSeek</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
