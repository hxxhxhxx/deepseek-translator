<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store / MSIX 清单模板。
  提交前必须替换：
    Identity Name      -> Partner Center 预留名称后分配的 Package/Identity/Name
    Identity Publisher -> Partner Center 分配的 Package/Identity/Publisher
    PublisherDisplayName -> Partner Center 的发布者显示名
  版本号使用四段式（1.6.2.0）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="Hexin.DeepSeekTranslator"
    Publisher="CN=Hexin"
    Version="1.6.2.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DeepSeek 划词翻译</DisplayName>
    <PublisherDisplayName>Hexin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>用 DeepSeek 翻译 Windows 任意位置的选中文本。</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="DeepSeekTranslator.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeepSeek 划词翻译"
        Description="用 DeepSeek 翻译 Windows 任意位置的选中文本。"
        BackgroundColor="#0F172A"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <!-- 开机自启：Store/MSIX 用 StartupTask，而不是 HKCU\Run -->
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="DeepSeekTranslator.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="DeepSeekTranslatorStartup" Enabled="false" DisplayName="DeepSeek 划词翻译" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
